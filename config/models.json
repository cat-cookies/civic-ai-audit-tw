{
  "schema_version": "4.0",
  "last_reviewed": "2026-08-04",
  "policy": {
    "allow_paid_fallback": false,
    "maximum_estimated_cost_usd": 0,
    "public_official_data_only_for_external_models": true,
    "block_personal_data_before_model_call": true,
    "fail_closed_when_free_status_unknown": true,
    "no_model_majority_as_evidence": true,
    "exclude_prc_model_developers": true,
    "require_provider_visibility_when_routing": true
  },
  "resource_modes": {
    "economy": {
      "calls": 1,
      "description": "單次結構化呼叫；適合一般政策、資料入口與低風險摘要。"
    },
    "standard": {
      "calls": 2,
      "description": "先規劃再綜合；適合跨國比較、研究設計與修法草稿。"
    },
    "critical": {
      "calls": 3,
      "description": "規劃、反方批判、綜合；只用於法律高風險、指控或來源衝突。"
    }
  },
  "providers": [
    {
      "id": "openrouter",
      "discovery": "https://openrouter.ai/api/v1/models",
      "eligibility": "input and output pricing must both be zero; developer prefix and actual provider must be approved",
      "blocked_prefixes": ["deepseek/", "qwen/", "z-ai/", "moonshotai/", "minimax/", "baidu/", "tencent/", "01-ai/", "thudm/", "stepfun/"],
      "allowed_prefixes": ["google/", "meta-llama/", "mistralai/", "openai/", "nvidia/", "microsoft/", "cohere/", "ai21/"],
      "routing": {"allow_fallbacks": false, "data_collection": "deny", "require_parameters": true},
      "official_docs": [
        "https://openrouter.ai/docs/guides/routing/model-variants/free",
        "https://openrouter.ai/docs/guides/routing/provider-selection",
        "https://openrouter.ai/docs/guides/privacy/provider-logging"
      ]
    },
    {
      "id": "gemini",
      "discovery": "https://generativelanguage.googleapis.com/v1beta/models",
      "eligibility": "generateContent-capable Flash or Lite model; use a separate project without billing for fail-closed free use",
      "official_docs": [
        "https://ai.google.dev/gemini-api/docs/pricing",
        "https://ai.google.dev/gemini-api/docs/rate-limits"
      ]
    },
    {
      "id": "groq",
      "discovery": "https://api.groq.com/openai/v1/models",
      "eligibility": "available on the developer plan and not blocked by origin policy; stop on rate-limit or account errors",
      "official_docs": [
        "https://console.groq.com/docs/rate-limits",
        "https://console.groq.com/docs/deprecations"
      ]
    },
    {
      "id": "cloudflare-workers-ai",
      "eligibility": "optional server-side provider with a configured daily soft cap below the free allocation",
      "official_docs": [
        "https://developers.cloudflare.com/workers-ai/platform/pricing/",
        "https://developers.cloudflare.com/workers-ai/models/"
      ]
    },
    {
      "id": "hugging-face-space",
      "role": "secure virtual router, not a model provider",
      "official_docs": [
        "https://huggingface.co/docs/hub/spaces-overview",
        "https://huggingface.co/docs/hub/spaces-sdks-docker",
        "https://huggingface.co/docs/hub/security-secrets"
      ]
    }
  ]
}
